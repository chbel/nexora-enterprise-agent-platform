# ── LLM Providers ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── LangSmith / Langfuse Observability ──────────────────────────
# Optional: leave empty to disable LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-agentic-ai
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Database ────────────────────────────────────────────────────
# Used when running the backend on the host. Docker Compose overrides it with the
# in-network URL built from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
DATABASE_URL=postgresql+asyncpg://agentic_user:secret@localhost:5432/agentic_ai
POSTGRES_USER=agentic_user
POSTGRES_PASSWORD=secret
POSTGRES_DB=agentic_ai

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Qdrant Vector DB ─────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=enterprise_knowledge

# ── Auth ────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── MCP Servers ──────────────────────────────────────────────────
POSTGRES_MCP_PORT=8001
DOCUMENT_MCP_PORT=8002
NOTIFICATION_MCP_PORT=8003
# Hostnames the executor uses to reach MCP servers (Compose sets service names)
POSTGRES_MCP_HOST=localhost
DOCUMENT_MCP_HOST=localhost
NOTIFICATION_MCP_HOST=localhost

# ── External MCP ────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
NOTION_TOKEN=secret_...
SLACK_BOT_TOKEN=xoxb-...
EXA_API_KEY=...

# ── S3 Storage ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-south-1
S3_BUCKET=enterprise-ai-docs

# ── App Settings ─────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_AGENT_ITERATIONS=10

# ── Docker Compose host ports (change if a port is already in use) ──
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
POSTGRES_MCP_HOST_PORT=8001
DOCUMENT_MCP_HOST_PORT=8002
NOTIFICATION_MCP_HOST_PORT=8003
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
# Install pytest into the backend image (needed for `docker compose exec backend pytest`)
INSTALL_DEV=true
